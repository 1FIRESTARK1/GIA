<Window x:Class="aromadom.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Продукция по материалу"
        Width="800"
        Height="500"
        MinWidth="600"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource Accent}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="ProductsGrid"
                  Grid.Row="1">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукция"
                                    Binding="{Binding [NameProduction]}"
                                    Width="*"/>

                <DataGridTextColumn x:Name="QuantityColumn"
                                    Header="Количество материала"
                                    Binding="{Binding [QuantityMaterialUnit],
                                        StringFormat={}{0:0.##########}}"
                                    Width="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   Margin="0,12,0,12"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Обновить"
                    Click="Refresh_Click"/>

            <Button Content="Назад"
                    Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>