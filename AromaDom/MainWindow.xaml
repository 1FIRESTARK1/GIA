<Window x:Class="aromadom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Арома Дом — материалы"
        Width="950"
        Height="650"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Арома Дом"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource Accent}"/>

            <TextBlock Text="Учёт материалов"
                       FontSize="18"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Button Content="Добавить материал"
                    Click="Add_Click"/>

            <Button Content="Обновить"
                    Click="Refresh_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="MaterialsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Beige}"
                                BorderBrush="{StaticResource Accent}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="15"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <Button Background="Transparent"
                                        Foreground="Black"
                                        Padding="0"
                                        Margin="0,0,0,8"
                                        HorizontalContentAlignment="Left"
                                        Click="Edit_Click"
                                        ToolTip="Редактировать материал">

                                    <TextBlock FontSize="17"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap">

                                        <Run Text="{Binding [TypeMaterial]}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding [NameMaterial]}"/>

                                    </TextBlock>
                                </Button>

                                <TextBlock>
                                    <Run Text="Минимальное количество: "/>
                                    <Run Text="{Binding [MinQuantity],
                                        StringFormat={}{0:0.##}}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding [Unit]}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Количество на складе: "/>
                                    <Run Text="{Binding [StockQuantity],
                                        StringFormat={}{0:0.##}}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding [Unit]}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding [PriceEd],
                                        StringFormat={}{0:F2}}"/>
                                    <Run Text=" р / Единица измерения: "/>
                                    <Run Text="{Binding [Unit]}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Требуемое количество: "/>
                                    <Run Text="{Binding [RequiredQuantity],
                                        StringFormat={}{0:F2}}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding [Unit]}"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,12,0,0">

                                    <Button Content="Редактировать"
                                            Click="Edit_Click"/>

                                    <Button Content="Продукция"
                                            Click="Products_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>