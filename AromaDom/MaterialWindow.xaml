<Window x:Class="aromadom.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Материал"
        Width="520"
        Height="650"
        MinWidth="450"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{StaticResource Accent}"
                   Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Тип материала"/>

                <ComboBox x:Name="TypeBox"
                          DisplayMemberPath="TypeMaterial"
                          SelectedValuePath="TypeMaterial"/>

                <TextBlock Text="Наименование"/>
                <TextBox x:Name="NameBox"
                         MaxLength="100"/>

                <TextBlock Text="Цена единицы материала"/>
                <TextBox x:Name="PriceBox"
                         ToolTip="Например: 125,50"/>

                <TextBlock Text="Единица измерения"/>
                <TextBox x:Name="UnitBox"
                         MaxLength="10"
                         ToolTip="Например: кг, л, шт"/>

                <TextBlock Text="Количество в упаковке"/>
                <TextBox x:Name="PackageBox"/>

                <TextBlock Text="Количество на складе"/>
                <TextBox x:Name="StockBox"/>

                <TextBlock Text="Минимальное количество"/>
                <TextBox x:Name="MinBox"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Назад"
                    Click="Back_Click"/>

            <Button Content="Сохранить"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>